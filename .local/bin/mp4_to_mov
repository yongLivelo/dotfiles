#!/bin/bash

# usage: mp4_to_mov [-d]   -d deletes each mp4 after a successful conversion

delete=0
[ "$1" = -d ] && delete=1

# Loop through all MP4 files
for i in *.mp4; do
  # Skip if no MP4 files exist
  [ -e "$i" ] || continue

  # Same basename, so a rerun doesn't duplicate
  out="${i%.mp4}.mov"
  [ -e "$out" ] && { echo "skip: $out exists"; continue; }

  # ProRes 422 + PCM: decodes in free Resolve on Linux, plays on iPad Pro 2018+ / Air 5+ / mini 6+
  if ffmpeg -nostdin -n -i "$i" \
    -c:v prores_ks -profile:v 2 -c:a pcm_s16le \
    "$out"; then
    [ "$delete" = 1 ] && rm -- "$i"
  fi
done
