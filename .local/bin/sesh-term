#!/usr/bin/env fish
# Sesh session picker. --popup draws it in a tmux popup (for the tmux keybind);
# without it, fzf takes over the current pane.

set -l fzf fzf
if contains -- --popup $argv
    set fzf fzf-tmux -p 80%,70%
end

set -l header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find'
set -l bindings \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 4 -t d -E .Trash -E .cache -E .local -E .git -E node_modules . ~)' \
    --bind 'ctrl-d:execute(tmux has-session -t {2..} 2>/dev/null && tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)'

set -l selection (command sesh list --icons | $fzf \
     --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
     --header $header \
     $bindings \
     --preview-window 'right:55%' \
     --preview 'command sesh preview {}'
 )

if test -n "$selection"
    command sesh connect "$selection"
end
