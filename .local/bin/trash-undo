#!/bin/bash

# Restore the last delete batch (everything trashed in the same second).
# Run again to walk further back. Home trash only; other mounts keep their own .Trash-*.
# Each restored batch is remembered so trash-redo can put it back.

trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
state="${XDG_STATE_HOME:-$HOME/.local/state}/trash-redo"

# shortcut: a batch is one DeletionDate second, so deletes a second apart undo separately

# group the .trashinfo files by DeletionDate in one pass, without a process per file
declare -A batches paths
for info in "$trash"/info/*.trashinfo; do
  [ -f "$info" ] || continue
  while IFS= read -r line; do
    case $line in
    Path=*)
      # undo the percent-encoding the trash spec applies to the original path
      # shortcut: %b also eats a literal backslash in the name; encode paths manually if that ever matters
      encoded=${line#Path=}
      printf -v path '%b' "${encoded//%/\\x}"
      paths["$info"]=$path
      ;;
    DeletionDate=*) batches[${line#DeletionDate=}]+="$info"$'\n' ;;
    esac
  done <"$info"
done

[ "${#batches[@]}" -gt 0 ] || {
  echo "trash is empty"
  exit 1
}
dates=$(printf '%s\n' "${!batches[@]}" | sort -u -r)

mkdir -p "$state"
# mktemp is atomic; the timestamp prefix sorts newest first for redo
batch=$(mktemp "$state/batch.$(date +%s%N).XXXXXX") || exit 1
failed=0

while IFS= read -r date; do
  [ -n "$date" ] || continue
  blocked=0
  # restore shallower paths first, so a directory exists before its contents
  sorted=''
  while IFS= read -r info; do
    [ -n "$info" ] || continue
    path=${paths[$info]}
    slashes=${path//[^\/]/}
    sorted+="${#slashes}"$'\t'"$info"$'\n'
  done <<<"${batches[$date]}"
  while IFS=$'\t' read -r _ info; do
    [ -n "$info" ] || continue
    name=${info##*/}
    name=${name%.trashinfo}
    path=${paths[$info]}
    # a payload removed out of band leaves metadata that must not block older batches
    if [ ! -e "$trash/files/$name" ] && [ ! -L "$trash/files/$name" ]; then
      echo "missing: $path" >&2
      rm -f -- "$info"
      continue
    fi
    # never clobber what is already there (gio does the same)
    if [ -e "$path" ] || [ -L "$path" ]; then
      echo "exists, skipped: $path"
      blocked=1
      continue
    fi
    mkdir -p -- "$(dirname -- "$path")" || {
      echo "failed: $path" >&2
      failed=1
      continue
    }
    # record before moving, so a failed state write cannot lose an undo we just did
    # shortcut: newline-delimited state, so a path containing a newline can't be redone
    printf '%s\n' "$path" >>"$batch" || {
      echo "failed to record for redo: $path" >&2
      exit 1
    }
    mv -- "$trash/files/$name" "$path" || {
      echo "failed: $path" >&2
      failed=1
      continue
    }
    rm -f -- "$info"
    echo "restored: $path"
  done <<<"$(printf '%s' "$sorted" | sort -t $'\t' -k1,1n)"
  # stop at the newest batch that did anything (restored, blocked or failed);
  # a failure must not quietly restore the older batch instead
  { [ -s "$batch" ] || [ "$blocked" = 1 ] || [ "$failed" = 1 ]; } && break
done <<<"$dates"

[ -s "$batch" ] || rm -f "$batch"
exit "$failed"
