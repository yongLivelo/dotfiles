#!/bin/bash

# usage: to_resolve [-d]
#   -d: delete the original after a successful conversion when the output is a different file

delete=0
while getopts ":d" opt; do
  case $opt in
  d) delete=1 ;;
  \?)
    printf 'usage: to_resolve [-d]\n' >&2
    exit 2
    ;;
  esac
done

# it works on the whole current folder; a filename would make it convert everything unseen
if [ "$OPTIND" -le "$#" ]; then
  printf 'usage: to_resolve [-d]\n' >&2
  exit 2
fi

shopt -s nocaseglob nullglob
# SIGKILL cannot run encode's cleanup trap, so drop parts whose owning PID is gone
for part in *.part.[0-9]*; do
  [ -f "$part" ] || continue
  pid=${part##*.}
  kill -0 "$pid" 2>/dev/null || rm -f -- "$part"
done
failed=0
declare -A written

video_fmt() {
  case "${1,,}" in
  mov | qt) echo mov ;;
  mkv) echo matroska ;;
  *) echo ;;
  esac
}

audio_fmt() {
  case "${1,,}" in
  wav) echo wav ;;
  aiff | aif) echo aiff ;;
  *) echo ;;
  esac
}

already_prores_pcm() {
  command -v ffprobe >/dev/null 2>&1 || return 1
  local v bad
  v=$(ffprobe -v error -select_streams V -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")
  [ -n "$v" ] || return 1
  bad=$(printf '%s\n' "$v" | grep -v '^prores$')
  [ -z "$bad" ] || return 1
  bad=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1" | grep -v '^pcm_')
  [ -z "$bad" ]
}

already_pcm_audio() {
  command -v ffprobe >/dev/null 2>&1 || return 1
  local v audio bad
  v=$(ffprobe -v error -select_streams V -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")
  [ -z "$v" ] || return 1
  audio=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")
  [ -n "$audio" ] || return 1
  bad=$(printf '%s\n' "$audio" | grep -v '^pcm_')
  [ -z "$bad" ]
}

# Pick the derived output, skipping a source that already has a good output.
choose_output() { # <source> <extension>; leaves the path in out, returns 1 when skipped
  local src=$1 ext=$2
  local candidate="${src%.*}.$ext"
  if [ -e "$src.$ext" ] || [ -n "${written["$candidate"]+set}" ]; then
    candidate="$src.$ext"
  fi
  if [ "$delete" = 1 ] && [ -e "$candidate" ]; then
    echo "skip: $src (-d with existing output $candidate)" >&2
  elif command -v ffprobe >/dev/null 2>&1 && [ -e "$candidate" ] &&
    ! { already_prores_pcm "$candidate" || already_pcm_audio "$candidate"; }; then
    echo "skip: $src (same-name source not converted: $candidate)" >&2
  elif [ -e "$candidate" ] && [ ! "$src" -nt "$candidate" ]; then
    echo "skip: $src (already converted to $candidate)"
  else
    out=$candidate
    return 0
  fi
  return 1
}

# Encode into .part, then move it over the target. Any failure sets failed, so a
# batch run exits non-zero and a caller can tell it did not finish.
encode() { # <input> <output> <format> [ffmpeg args...]
  local f=$1 out=$2 fmt=$3
  shift 3
  # replacing a symlink would leave its target unconverted and split the library
  if [ -L "$out" ]; then
    echo "skip: $f (output is a symlink: $out)" >&2
    return
  fi
  local part="$out.part.$$"
  local outarg=$part
  case $outarg in /*) ;; *) outarg=./$outarg ;; esac # ffmpeg needs ./ for leading-dash names
  local mode=''
  [ "$out" = "$f" ] && mode=$(stat -c %a -- "$f" 2>/dev/null || stat -f %Lp -- "$f" 2>/dev/null)
  rm -f -- "$part"
  # a signal must not leave a media file behind for Resolve to pick up
  trap 'rm -f -- "$part"; exit 1' EXIT INT TERM
  printf 'encoding: %s -> %s\n' "$f" "$out"
  if ! ffmpeg -nostdin -loglevel error -stats -n -i "$f" "$@" -f "${fmt:-${out##*.}}" "$outarg"; then
    rm -f -- "$part"
    trap - EXIT INT TERM
    failed=1
    return
  fi
  if mv -f -- "$part" "$out"; then
    trap - EXIT INT TERM
    written["$out"]=1
    [ -z "$mode" ] || chmod "$mode" -- "$out" || failed=1
    if [ "$delete" = 1 ] && [ "$out" != "$f" ]; then
      rm -- "$f" || {
        echo "failed to delete: $f" >&2
        failed=1
      }
    fi
  else
    rm -f -- "$part"
    trap - EXIT INT TERM
    failed=1
  fi
}

# Re-encode videos to ProRes 422 + PCM. Keep the same filename/extension when the
# container supports ProRes (.mov, .qt, .mkv); otherwise write a .mov for Resolve compatibility.
for f in *.mp4 *.mov *.qt *.mkv *.webm *.avi *.m4v *.ts *.flv *.mpg *.mpeg *.wmv *.m2ts *.mts *.vob; do
  [ -f "$f" ] || continue
  # *.ts and *.mts are also TypeScript: only treat them as video when ffprobe finds a video stream
  case "${f,,}" in
  *.ts | *.mts)
    command -v ffprobe >/dev/null 2>&1 || {
      echo "skip: $f (ffprobe unavailable)"
      continue
    }
    if [ -z "$(ffprobe -v error -select_streams V:0 -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$f" 2>/dev/null)" ]; then
      echo "skip: $f (not a video)"
      continue
    fi
    ;;
  esac
  fmt=$(video_fmt "${f##*.}")
  if [ -n "$fmt" ]; then
    if ! command -v ffprobe >/dev/null 2>&1; then
      echo "skip: $f (ffprobe unavailable)"
      continue
    fi
    # an audio-only .mov/.mkv is done once its audio is PCM
    if already_prores_pcm "$f" || already_pcm_audio "$f"; then
      echo "skip: $f (already ProRes/PCM)"
      continue
    fi
    out="$f"
  else
    choose_output "$f" mov || continue
  fi

  # Map video and subtitles, then test-decode each audio stream into PCM so undecodable
  # tracks (like Apple Spatial Audio / apple_apac) are cleanly dropped.
  maps=(-map '0:V?' -map '0:s?')
  if command -v ffprobe >/dev/null 2>&1; then
    audio_count=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 -- "$f" 2>/dev/null | wc -l)
    for ((i = 0; i < audio_count; i++)); do
      if ffmpeg -nostdin -v error -i "$f" -map "0:a:$i" -t 0.001 -c:a pcm_s16le -f null - >/dev/null 2>&1; then
        maps+=(-map "0:a:$i")
      else
        echo "note: dropping undecodable audio track #a:$i: $f" >&2
      fi
    done
  else
    maps+=(-map '0:a?')
  fi

  if [ "$fmt" = matroska ]; then
    maps+=(-map '0:t?' -c:s copy -c:t copy)
  else
    # mov can't store attachments; mov_text is the subtitle codec it accepts
    # shortcut: bitmap subtitles (dvdsub, PGS) still fail loudly instead of being dropped
    if [ -n "$(ffprobe -v error -select_streams t -show_entries stream=index -of csv=p=0 -- "$f" 2>/dev/null)" ]; then
      echo "note: dropping attachments (mov cannot store them): $f" >&2
    fi
    maps+=(-c:s mov_text)
  fi
  encode "$f" "$out" "$fmt" "${maps[@]}" -pix_fmt yuv422p10le -c:v prores_aw -profile:v 2 -c:a pcm_s16le
done

# Re-encode audio to PCM. Keep the same filename/extension when the container supports PCM;
# otherwise write a .wav for Resolve compatibility.
for f in *.mp3 *.aac *.m4a *.ogg *.opus *.flac *.wma *.wav *.aiff *.aif; do
  [ -f "$f" ] || continue
  fmt=$(audio_fmt "${f##*.}")
  if [ -n "$fmt" ]; then
    if ! command -v ffprobe >/dev/null 2>&1; then
      echo "skip: $f (ffprobe unavailable)"
      continue
    fi
    if already_pcm_audio "$f"; then
      echo "skip: $f (already PCM)"
      continue
    fi
    out="$f"
  else
    choose_output "$f" wav || continue
  fi
  # AIFF is big-endian, so the muxer rejects little-endian PCM
  [ "$fmt" = aiff ] && acodec=pcm_s24be || acodec=pcm_s24le
  encode "$f" "$out" "$fmt" -map 0:a -c:a "$acodec"
done

exit "$failed"
