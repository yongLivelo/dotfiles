#!/bin/sh
# Godot external editor: open the script in the nvim instance registered for that project.
# Each nvim registers its socket for its cwd in $XDG_RUNTIME_DIR/nvim-projects-<uid>/<sha256>.
file=$(realpath -m -- "${1:-.}")
line=${2:-1}
case $line in
'' | *[!0-9]*) echo "invalid line: $line" >&2; exit 2 ;;
esac
dir=${XDG_RUNTIME_DIR:-/tmp}

root=$(dirname -- "$file")
while [ "$root" != "/" ] && [ ! -f "$root/project.godot" ]; do
	root=$(dirname -- "$root")
done
[ -f "$root/project.godot" ] || root=

sock=
if [ -n "$root" ]; then
	map="$dir/nvim-projects-$(id -u)/$(printf %s "$root" | sha256sum | cut -d' ' -f1)"
	[ -f "$map" ] && sock=$(cat "$map")
fi

if [ -z "$sock" ] || ! nvim --headless --server "$sock" --remote-expr '1' >/dev/null 2>&1; then
	# no registered instance: one started in the project root will register itself
	if [ -n "$root" ]; then
		cd "$root" || exit 1
	fi
	exec kitty nvim "+$line" "$file"
fi

# --remote-expr evaluates Vim script: a quote is escaped by doubling it
escaped=$(printf %s "$file" | sed "s/'/''/g")
nvim --headless --server "$sock" --remote-expr "execute('edit +$line ' . fnameescape('$escaped'))" >/dev/null
