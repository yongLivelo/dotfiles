# Mode & View
view digital
mode clock
set hour-24 off
set seconds on
set date on
set auto-size on

# Alarm command (must be wrapped in single quotes)
timer-exec 'nohup mpv --no-video --no-terminal /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga >/dev/null 2>&1 & notify-send -u critical "Peaclock" "Timer finished!"'

# Tokyo Night Palette
style background clear
style active-fg #7aa2f7
style active-bg #7aa2f7
style inactive-fg #292e42
style inactive-bg #292e42
style colon-fg #bb9af7
style colon-bg clear
style date #7dcfff
style text #a9b1d6
style prompt #9ece6a
style success #9ece6a
style error #f7768e
