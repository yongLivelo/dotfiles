{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "custom-api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "salamatarchie",
      "options": {
        "baseURL": "https://llmrouter.boyemma.com/v1",
        "apiKey": "{env:BOYEMMA_API_KEY}",
      },
      "models": {
        "auto": {
          "name": "auto",
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
        },
      },
    },
  },
  "model": "custom-api/gemini-3.5-flash",
}
