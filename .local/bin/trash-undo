#!/bin/bash

# Restore the last delete batch (everything trashed in the same second).
# Run again to walk further back. Home trash only; other mounts keep their own .Trash-*.
# Each restored batch is remembered so trash-redo can put it back.

trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
state="${XDG_STATE_HOME:-$HOME/.local/state}/trash-redo"

# shortcut: a batch is one DeletionDate second, so deletes a second apart undo separately
dates=$(grep -h '^DeletionDate=' "$trash"/info/*.trashinfo 2>/dev/null | sort -u -r)
[ -n "$dates" ] || {
  echo "trash is empty"
  exit 1
}

mkdir -p "$state"
batch=$(mktemp "$state/batch.XXXXXX")

while IFS= read -r date; do
  [ -n "$date" ] || continue
  for info in "$trash"/info/*.trashinfo; do
    grep -qxF "$date" "$info" || continue
    name=${info##*/}
    name=${name%.trashinfo}
    # undo the percent-encoding the trash spec applies to the original path
    # shortcut: %b also eats a literal backslash in the name; encode paths manually if that ever matters
    raw=$(sed -n 's/^Path=//p' "$info")
    printf -v path '%b' "${raw//%/\\x}"
    # never clobber what is already there (gio does the same)
    if [ -e "$path" ] || [ -L "$path" ]; then
      echo "exists, skipped: $path"
      continue
    fi
    mkdir -p -- "$(dirname -- "$path")" || continue
    mv -- "$trash/files/$name" "$path" || continue
    rm -f -- "$info"
    echo "restored: $path"
    # shortcut: newline-delimited state, so a path containing a newline can't be redone
    printf '%s\n' "$path" >>"$batch"
  done
  [ -s "$batch" ] && break
done <<<"$dates"

[ -s "$batch" ] || rm -f "$batch"
