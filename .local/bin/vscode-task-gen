#!/bin/bash
set -euo pipefail

dir="${1:-.}"
vscode_dir="$dir/.vscode"
out="$vscode_dir/tasks.json"

# ask <prompt> <variable>; stop instead of leaving a half-written setup on EOF
ask() {
  printf '%s' "$1" >&2
  if ! read -r "$2"; then
    echo >&2
    echo "Aborted." >&2
    exit 1
  fi
}

if [ -f "$out" ]; then
  printf "tasks.json already exists at %s\n" "$out" >&2
  ask "Overwrite? [y/N] " ans
  case "$ans" in
    [yY]*) ;;
    *) echo "Aborted." >&2; exit 1 ;;
  esac
fi

ask "Task label [Run command]: " label
label="${label:-Run command}"

ask "Command to run (required): " cmd
if [ -z "$cmd" ]; then
  echo "Command cannot be empty." >&2
  exit 1
fi

ask "Working directory [\${workspaceFolder}]: " cwd
[ -n "$cwd" ] || cwd='${workspaceFolder}'

created=0
if [ ! -d "$vscode_dir" ]; then
  mkdir -p "$vscode_dir"
  created=1
fi

tmp=$(mktemp "$vscode_dir/tasks.json.tmp.XXXXXX")
if python3 -c "
import json, sys

label = sys.argv[1]
cmd = sys.argv[2]
cwd = sys.argv[3]

data = {
  \"version\": \"2.0.0\",
  \"tasks\": [
    {
      \"label\": label,
      \"type\": \"shell\",
      \"command\": cmd,
      \"options\": {\"cwd\": cwd},
      \"problemMatcher\": []
    }
  ]
}
json.dump(data, sys.stdout, indent=2)
print()
" "$label" "$cmd" "$cwd" > "$tmp" && mv "$tmp" "$out"; then
  echo "Wrote $out"
else
  rm -f "$tmp"
  [ "$created" = 1 ] && rmdir "$vscode_dir" 2>/dev/null || true
  echo "Failed to write tasks.json; left existing file untouched." >&2
  exit 1
fi
