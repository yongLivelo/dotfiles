#!/bin/bash

# usage: to_resolve [-d]
#   -d: delete the original after a successful conversion when the output is a different file

delete=0
while getopts ":d" opt; do
  case $opt in
    d) delete=1 ;;
  esac
done

shopt -s nocaseglob nullglob

video_fmt() {
  case "${1,,}" in
    mp4|m4v) echo mp4 ;;
    mov|qt) echo mov ;;
    mkv) echo matroska ;;
    avi) echo avi ;;
    ts|m2ts) echo mpegts ;;
    flv) echo flv ;;
    webm) echo webm ;;
    *) echo mov ;;
  esac
}

audio_fmt() {
  case "${1,,}" in
    wav) echo wav ;;
    aiff|aif) echo aiff ;;
    *) echo ;;
  esac
}

already_prores_pcm() {
  command -v ffprobe >/dev/null 2>&1 || return 1
  local v bad
  v=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")
  [ "$v" = "prores" ] || return 1
  bad=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1" | grep -v '^pcm_')
  [ -z "$bad" ]
}

already_pcm_audio() {
  command -v ffprobe >/dev/null 2>&1 || return 1
  local v bad
  v=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")
  [ -z "$v" ] || return 1
  bad=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1" | grep -v '^pcm_')
  [ -n "$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of default=nw=1:nk=1 -- "$1")" ] && [ -z "$bad" ]
}

# Re-encode videos to ProRes 422 + PCM, keeping the same filename/extension.
for f in *.mp4 *.mov *.mkv *.webm *.avi *.m4v *.ts *.flv; do
  [ -f "$f" ] || continue
  if already_prores_pcm "$f"; then
    echo "skip: $f (already ProRes/PCM)"
    continue
  fi

  ext="${f##*.}"
  fmt=$(video_fmt "$ext")
  part="$f.part"

  rm -f -- "$part"
  # .part hides the extension, so the muxer must be named explicitly
  if ffmpeg -nostdin -n -i "$f" \
    -c:v prores_ks -profile:v 2 -c:a pcm_s16le \
    -f "$fmt" "$part"; then
    if mv -f -- "$part" "$f"; then
      :
    else
      rm -f -- "$part"
    fi
  else
    rm -f -- "$part"
  fi
done

# Re-encode audio to PCM. Keep the same filename/extension when the container supports PCM;
# otherwise write a .wav for Resolve compatibility.
for f in *.mp3 *.aac *.m4a *.ogg *.opus *.flac *.wma; do
  [ -f "$f" ] || continue
  ext="${f##*.}"
  fmt=$(audio_fmt "$ext")
  if [ -n "$fmt" ]; then
    if already_pcm_audio "$f"; then
      echo "skip: $f (already PCM)"
      continue
    fi
    out="$f"
    part="$f.part"
  else
    base="${f%.*}"
    out="${base}.wav"
    part="$out.part"
    if [ -e "$out" ]; then
      echo "skip: $f (already converted to $out)"
      continue
    fi
  fi

  rm -f -- "$part"
  if ffmpeg -nostdin -n -i "$f" \
    -vn -c:a pcm_s24le \
    -f "${fmt:-wav}" "$part"; then
    if mv -f -- "$part" "$out"; then
      [ "$delete" = 1 ] && [ "$out" != "$f" ] && rm -- "$f"
    else
      rm -f -- "$part"
    fi
  else
    rm -f -- "$part"
  fi
done



