# Zathura configuration - Tokyo Night theme

# General settings
set selection-clipboard clipboard
set adjust-open "best-fit"
set pages-per-row 1
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-step 50
set font "JetBrains Mono 11"

# Colors (Tokyo Night)
set default-bg                  "#1a1b26"
set default-fg                  "#c0caf5"

set statusbar-bg                "#16161e"
set statusbar-fg                "#c0caf5"

set inputbar-bg                 "#16161e"
set inputbar-fg                 "#7aa2f7"

set notification-bg             "#16161e"
set notification-fg             "#c0caf5"

set notification-error-bg       "#f7768e"
set notification-error-fg       "#1a1b26"

set notification-warning-bg     "#e0af68"
set notification-warning-fg     "#1a1b26"

set highlight-color             "rgba(122, 162, 247, 0.5)"
set highlight-active-color      "rgba(247, 118, 142, 0.5)"

set completion-bg               "#24283b"
set completion-fg               "#c0caf5"

set completion-highlight-bg     "#7aa2f7"
set completion-highlight-fg     "#16161e"

# Recolor (toggle dark mode with Ctrl+r)
set recolor                     "false"
set recolor-keephue             "true"
set recolor-lightcolor          "#1a1b26"
set recolor-darkcolor           "#c0caf5"
set recolor-reverse-video       "true"

# Keybindings
map r reload
map p print
map R rotate
map [fullscreen] a adjust_window best-fit
map [fullscreen] s adjust_window width
